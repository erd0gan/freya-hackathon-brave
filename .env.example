# LLM access (PLAN §0.1: OpenRouter). Leave empty to run offline with FakeProvider.
# In the cloud environment the proxy injects the real key: any placeholder value works.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Freya platform (no account yet — every Freya field is VERIFY until smoke-tested).
FREYA_API_KEY=
FREYA_BASE_URL=https://app.freyavoice.ai/api/v2
FREYA_WORKSPACE_ID=
# Optional: persona LLMs per user variant (valid values VERIFY), JSON list of {provider, model}
# FREYA_PERSONA_LLMS=[{"provider":"openai","model":"..."},{"provider":"google","model":"..."}]

# Hard cap across all runs (persistent ledger in .builder/cost_ledger.jsonl).
MAX_COST_USD=50

# Model profile: `test` (cheap, default) or `competition` (stronger builder/optimizer).
BUILDER_PROFILE=test
# Optional per-role overrides (OpenRouter slugs), e.g.:
# BUILDER_MODEL_BUILDER=anthropic/claude-sonnet-5.5
# BUILDER_MODEL_AGENT=openai/gpt-6-luna-pro

},\n        \"pre_actions\": [api_fn(fname, path, body)],\n        \"response_mapping\": [{\"path\": \"data\", \"variable\": prefix + \"_body\"},\n                             {\"path\": \"status_code\", \"variable\": prefix + \"_code\"},\n                             {\"path\": \"data.result.returnCode\", \"variable\": prefix + \"_rc\"}],\n        \"transitions\": [{\"target_node\": nxt, \"description\": \"always\", \"condition\": {\"operator\": \"always\"}}],\n    }\n\n\ndef end_node(name, fname, text):\n    END_NODES.append(name)\n    nodes[name] = {\n        \"name\": name, \"node_type\": \"end_call\", \"on_enter\": {\"type\": \"silent\"},\n        \"disable_inactivity_monitor\": True, \"transitions\": [],\n        \"terminal\": {\"type\": \"function\", \"function\": {\"name\": fname, \"handler\": \"__function__:end_call\",\n            \"parameters\": {\"type\": \"object\", \"properties\": {\n                \"message_mode\": {\"type\": \"string\", \"default\": \"custom\"},\n                \"spoken_message\": {\"type\": \"string\", \"default\": text}}}}},\n    }\n\n\ndef eq(var, val):\n    return {\"logic\": \"or\", \"conditions\": [{\"variable\": var, \"operator\": \"equals\", \"operand\": val}]}\n\n\ndef eq_and(pairs):\n    return {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [\n        {\"variable\": v, \"operator\": \"equals\", \"operand\": o} for v, o in pairs]}]}\n\n\ndef conv(name, text, task, extraction, transitions, max_turns=6, fallback=None):\n    n = {\n        \"name\": name, \"node_type\": \"conversation\", \"on_enter\": {\"type\": \"tts\", \"text\": text},\n        \"task_message\": task + \" Bu adımda araç çağırma.\", \"tools\": [], \"extraction_schema\": extraction,\n        \"transitions\": transitions, \"max_node_turns\": max_turns,\n        \"max_turn_transition\": fallback or \"end_tries\", \"interruptible\": True,\n    }\n    nodes[name] = n\n\n\nHELPERS = r'''\nimport json, re, datetime\nONES = ['', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz']\nTENS = ['', 'on', 'yirmi', 'otuz', 'kırk', 'elli', 'altmış', 'yetmiş', 'seksen', 'doksan']\nDIG = ['sıfır', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz']\nMONTHS = ['', 'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık']\ndef w3(n):\n    h, r = divmod(n, 100); t, o = divmod(r, 10); s = []\n    if h: s.append(('' if h == 1 else ONES[h] + ' ') + 'yüz')\n    if t: s.append(TENS[t])\n    if o: s.append(ONES[o])\n    return ' '.join(s)\ndef words(n):\n    n = int(n)\n    if n == 0: return 'sıfır'\n    parts = []\n    for val, name in ((10**9, 'milyar'), (10**6, 'milyon'), (1000, 'bin')):\n        q, n = divmod(n, val)\n        if q:\n            if val == 1000 and q == 1: parts.append('bin')\n            else: parts.append(w3(q) + ' ' + name)\n    if n: parts.append(w3(n))\n    return ' '.join(parts)\nCUR = {'TL': ('Türk Lirası', 'lira', 'kuruş'), 'USD': ('Dolar', 'dolar', 'sent'), 'EUR': ('Euro', 'euro', 'sent'), 'GBP': ('İngiliz Sterlini', 'sterlin', 'peni')}\ndef amt(x, c):\n    x = round(abs(float(x)) * 100); m, k = divmod(int(x), 100)\n    full, unit, sub = CUR[c]\n    if k == 0: return words(m) + ' ' + full\n    return words(m) + ' ' + unit + ' ' + words(k) + ' ' + sub\ndef pdate(s):\n    try:\n        d, m, y = str(s).split('.'); return datetime.date(int(y), int(m), int(d))\n    except Exception:\n        return None\ndef sdate(s):\n    d = pdate(s)\n    return (str(d.day) + ' ' + MONTHS[d.month] + ' ' + str(d.year)) if d else ''\ndef today():\n    try: return datetime.date.fromisoformat(str(vars.get('now') or '')[:10])\n    except Exception: return None\ndef digits(s):\n    return ' '.join(DIG[int(c)] for c in str(s) if c.isdigit())\ndef num(v):\n    try: return float(v)\n    except Exception: return None\ndef obj(v):\n    if isinstance(v, dict): return v\n    if isinstance(v, str):\n        try:\n            o = json.loads(v)\n            if isinstance(o, dict): return o\n        except Exception:\n            try:\n                import ast; o = ast.literal_eval(v)\n                if isinstance(o, dict): return o\n            except Exception: pass\n    return {}\ndef body(prefix):\n    b = obj(vars.get(prefix + '_body'))\n    return b\ndef code_of(prefix):\n    c = str(vars.get(prefix + '_code') or '')\n    b = body(prefix)\n    rc = str(vars.get(prefix + '_rc') or (b.get('result') or {}).get('returnCode') or '')\n    return c, rc, b\n'''\n\n# ---- cards ----\napi_node(\"fetch_cards\", \"cards_list\", \"/cards.list\", {\"customerNo\": \"{{customerNumber}}\", \"aiFlow\": \"CardOps\"}, \"cl\", \"prep_cards\")\ncode_node(\"prep_cards\", HELPERS + r'''\ntry:\n    c, rc, b = code_of('cl')\n    d = b.get('data') if isinstance(b.get('data'), dict) else {}\n    cards = d.get('cards') if isinstance(d.get('cards'), list) else []\n    cards = [x for x in cards if isinstance(x, dict) and str(x.get('status') or 'A') == 'A']\n    if cards and rc in ('1', ''):\n        vars['cards_json'] = json.dumps(cards, ensure_ascii=False)\n        vars['card_count'] = str(len(cards))\n        vars['card_state'] = 'one' if len(cards) == 1 else 'multi'\n        names = []\n        for x in cards:\n            n = (x.get('productName') or '').strip()\n            if n and n not in names and len(n) <= 40: names.append(n)\n        ex = names[:2]\n        if len(ex) >= 2: vars['card_question'] = 'Hangi kartınızın borcunu öğrenmek istersiniz? Örneğin, ' + ex[0] + ' veya ' + ex[1] + ' diyebilirsiniz.'\n        elif ex: vars['card_question'] = 'Hangi kartınızın borcunu öğrenmek istersiniz? Örneğin, ' + ex[0] + ' diyebilirsiniz.'\n        else: vars['card_question'] = 'Hangi kartınızın borcunu öğrenmek istersiniz? Kartınızın son dört hanesini söyleyebilirsiniz.'\n        vars['card_names'] = ', '.join(names)\n        if len(cards) == 1:\n            vars['sel_card'] = cards[0].get('cardNumber') or ''\n            vars['sel_last4'] = cards[0].get('cardNumberLast4') or str(vars['sel_card'])[-4:]\n            vars['sel_name'] = (cards[0].get('productName') or '').strip()\n    elif c == '404' or 'FB_IVR_CHANNEL_102' in rc or 'FB_IVR_CHANNEL_102' in json.dumps(b):\n        vars['card_state'] = 'none'\n    else:\n        vars['card_state'] = 'error'\n    vars['card_tries'] = '0'\n    vars['card_choice'] = ''\nexcept Exception as e:\n    vars['card_state'] = 'error'\n''', \"end_error\", [\n    {\"target_node\": \"end_no_card\", \"description\": \"no card\", \"condition\": eq(\"card_state\", \"none\")},\n    {\"target_node\": \"fetch_balance\", \"description\": \"one card\", \"condition\": eq(\"card_state\", \"one\")},\n    {\"target_node\": \"select_card\", \"description\": \"multi\", \"condition\": eq(\"card_state\", \"multi\")},\n])\n\nconv(\"select_card\", \"{{card_question}}\",\n     \"Arayanın hangi kartı seçtiğini anla. Kartları: {{card_names}}. Arayan bütün kartları isterse kartlar tek tek sorgulanabildiği için tek bir kart seçmesini iste. \"\n     \"Kartın ilk hanelerini veya tam numarasını asla söyleme.\",\n     [{\"name\": \"card_choice\", \"type\": \"string\", \"min_confidence\": 0.5,\n       \"description\": \"Arayanın seçtiği kartın adı (ör. Yıldız Premium) veya söylediği kart haneleri rakamla (ör. 4253). 'Hepsi/bütün kartlar' derse ALL. Belirsizse boş.\"}],\n     [{\"target_node\": \"resolve_card\", \"description\": \"caller named a card\",\n       \"condition\": {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [\n           {\"variable\": \"card_choice\", \"operator\": \"is_set\"}, {\"variable\": \"card_choice\", \"operator\": \"not_equals\", \"operand\": \"\"}]}]}}],\n     max_turns=4)\n\ncode_node(\"resolve_card\", HELPERS + r'''\ntry:\n    cards = json.loads(vars.get('cards_json') or '[]')\n    ch = str(vars.get('card_choice') or '').strip()\n    vars['card_choice'] = ''\n    t = int(vars.get('card_tries') or 0)\n    dg = ''.join(c for c in ch if c.isdigit())\n    low = ch.lower().replace('ı', 'i').replace('İ', 'i')\n    def norm(s): return str(s or '').lower().replace('ı', 'i').replace('İ', 'i')\n    match = []\n    pool = cards\n    try:\n        prev = json.loads(vars.get('cand_json') or '[]')\n        if prev: pool = prev\n    except Exception:\n        pass\n    if ch.upper() == 'ALL':\n        match = []\n    elif len(dg) >= 10:\n        match = [x for x in cards if str(x.get('cardNumber') or '')[:6] == dg[:6] and str(x.get('cardNumber') or '')[-4:] == dg[-4:]]\n    elif len(dg) >= 4:\n        match = [x for x in pool if str(x.get('cardNumberLast4') or str(x.get('cardNumber'))[-4:])[-4:] == dg[-4:]]\n        if not match:\n            match = [x for x in cards if str(x.get('cardNumberLast4') or str(x.get('cardNumber'))[-4:])[-4:] == dg[-4:]]\n    else:\n        match = [x for x in cards if norm(x.get('productName')) and (norm(x.get('productName')) == low)]\n        if not match:\n            match = [x for x in cards if norm(x.get('productName')) and (low in norm(x.get('productName')) or norm(x.get('productName')) in low)]\n    vars['cand_json'] = ''\n    if len(match) == 1 and match[0].get('isMainCard') is False:\n        t += 1\n        vars['card_tries'] = str(t)\n        vars['resolve_state'] = 'tries' if t >= 3 else 'again'\n        vars['card_question'] = 'Bu kart ile ekstre borcu sorgulanamıyor, uygun bir kart değil. Lütfen başka bir kartınızı seçin. Kartlarınız: ' + vars.get('card_names', '') + '.'\n        match = None\n    if match is None:\n        pass\n    elif len(match) == 1:\n        x = match[0]\n        vars['sel_card'] = x.get('cardNumber') or ''\n        vars['sel_last4'] = x.get('cardNumberLast4') or str(vars['sel_card'])[-4:]\n        vars['sel_name'] = (x.get('productName') or '').strip()\n        vars['resolve_state'] = 'ok'\n    else:\n        t += 1\n        vars['card_tries'] = str(t)\n        if t >= 3:\n            vars['resolve_state'] = 'tries'\n        else:\n            vars['resolve_state'] = 'again'\n            if ch.upper() == 'ALL':\n                vars['card_question'] = 'Bakiye sorgusu tek kart için yapılabiliyor. ' + vars.get('card_question', '').split('? ')[0] + '? Kartlarınız: ' + vars.get('card_names', '') + '.'\n            elif len(match) > 1 and len(dg) < 4:\n                vars['cand_json'] = json.dumps(match, ensure_ascii=False)\n                nm = []\n                for x in match:\n                    n = (x.get('productName') or '').strip()\n                    if n and n not in nm: nm.append(n)\n                if len(nm) == 1:\n                    vars['card_question'] = nm[0] + ' isimli birden fazla kartınız var. Kartınızın son dört hanesini söyler misiniz?'\n                else:\n                    vars['card_question'] = 'Bu isme uyan kartlarınız: ' + ', '.join(nm) + '. Hangisinin borcunu öğrenmek istersiniz?'\n            elif len(match) > 1 and len(dg) < 6:\n                vars['cand_json'] = json.dumps(match, ensure_ascii=False)\n                vars['card_question'] = 'Son dört hanesi ' + dg[-4:] + ' olan birden fazla kartınız var. Kartınızın son altı hanesini söyler misiniz?'\n            elif len(match) > 1:\n                vars['cand_json'] = json.dumps(match, ensure_ascii=False)\n                vars['card_question'] = 'Son altı hanesi aynı olan birden fazla kartınız var. Kart numaranızı söyler misiniz?'\n            else:\n                vars['card_question'] = 'Bu isimde uygun bir kartınız bulunmuyor. Kartlarınız: ' + vars.get('card_names', '') + '. Hangisinin borcunu öğrenmek istersiniz?'\nexcept Exception:\n    vars['resolve_state'] = 'tries'\n''', \"select_card\", [\n    {\"target_node\": \"fetch_balance\", \"description\": \"ok\", \"condition\": eq(\"resolve_state\", \"ok\")},\n    {\"target_node\": \"end_tries\", \"description\": \"tries\", \"condition\": eq(\"resolve_state\", \"tries\")},\n])\n\n# ---- balance ----\napi_node(\"fetch_balance\", \"cards_balance\", \"/cards.balance\", {\"cardNumber\": \"{{sel_card}}\"}, \"bal\", \"fetch_email\")\napi_node(\"fetch_email\", \"contact_email_get\", \"/contact.email.get\", {\"customerNo\": \"{{customerNumber}}\", \"intAddressInfoType\": \"E\"}, \"em\", \"build_reading\")\ncode_node(\"build_reading\", HELPERS + r'''\ntry:\n    c, rc, b = code_of('bal')\n    d = b.get('data') if isinstance(b.get('data'), dict) else {}\n    if not d or rc not in ('1', ''):\n        vars['read_state'] = 'error'\n    else:\n        vars['read_state'] = 'ok'\n        last4 = vars.get('sel_last4') or str(d.get('cardNumberLast4') or '')\n        name = vars.get('sel_name') or (d.get('productName') or '').strip()\n        intro = 'Sonu ' + digits(last4) + ' ile biten ' + (name + ' kartınıza ait' if name else 'kartınıza ait')\n        tdy = today()\n        sd = pdate(d.get('statementDate')); ld = pdate(d.get('lastPayDate'))\n        vars['stmt_date'] = d.get('statementDate') or ''\n        parts = []\n        blocks = {}\n        for cc in ('TL', 'USD', 'EUR', 'GBP'):\n            bl = d.get('debt' + cc)\n            if isinstance(bl, dict) and bl: blocks[cc] = bl\n        def has(cc):\n            bl = blocks.get(cc)\n            if not bl: return False\n            r = num(bl.get('remainingDebt')); s = num(bl.get('statementDebt'))\n            if cc == 'TL':\n                return r is not None and r > 0\n            return (s is not None and s > 0) and (r is None or r > 0) or (r is not None and r > 0)\n        owing = [cc for cc in ('TL', 'USD', 'EUR', 'GBP') if has(cc)]\n        vars['stmt_currency'] = owing[0] if owing else 'TL'\n        if not sd:\n            parts.append(intro + ' kesilmiş bir ekstre bulunmadığından ekstre borcunuz bulunmamaktadır.')\n        elif str(d.get('statementPaymentStatus')) == 'NO_DEBT' or not owing:\n            tl = blocks.get('TL') or {}\n            s = intro.replace(' kartınıza ait', ' kartınızın').replace('ile biten kartınızın', 'ile biten kartınızın') + ' ' + sdate(d.get('statementDate')) + ' tarihli ekstresinden borcunuz bulunmamaktadır.'\n            tot = num(tl.get('totalDebt'))\n            if tot is not None and tot > 0:\n                s += ' Gelecek dönemler dahil toplam borcunuz ' + amt(tot, 'TL') + '.'\n            nd = d.get('nextLastPayDate') or d.get('lastPayDate')\n            if nd: s += ' Son ödeme tarihiniz ' + sdate(nd) + ' olacaktır.'\n            parts.append(s)\n        else:\n            if tdy and sd and tdy == sd:\n                parts.append('Hesap kesim tarihiniz bugün, ekstreniz saat 00.00 itibarıyla kesilecek.')\n            first = True\n            for cc in owing:\n                bl = blocks[cc]\n                pre = (intro + ' ' + sdate(d.get('statementDate')) + ' tarihinde kesilen ekstre ') if first else ''\n                first = False\n                X = num(bl.get('statementDebt')) or 0; Z = num(bl.get('minPayment')) or 0\n                Y = num(bl.get('remainingDebt')) or 0; T = num(bl.get('remainingMinPayment')) or 0\n                if cc == 'TL':\n                    if T > 0 and T >= Z:\n                        s = 'Türk Lirası borcunuz ' + amt(X, 'TL') + ', ödenmesi gereken minimum tutar ' + amt(Z, 'TL') + '.'\n                    elif T <= 0:\n                        s = 'Türk Lirası borcunuz ' + amt(X, 'TL') + ', kalan toplam borcunuz ' + amt(Y, 'TL') + '. Minimum ödemenizi yaptığınız için teşekkür ederiz.'\n                    else:\n                        s = 'Türk Lirası borcunuz ' + amt(X, 'TL') + ', ödenmesi gereken minimum tutar ' + amt(Z, 'TL') + ', kalan toplam borcunuz ' + amt(Y, 'TL') + ', kalan minimum ödeme tutarınız ' + amt(T, 'TL') + '.'\n                else:\n                    full = CUR[cc][0]\n                    s = full + ' borcunuz ' + amt(X, cc) + ', kalan toplam borcunuz ' + amt(Y, cc) + ', ödenmesi gereken minimum tutar ' + amt(Z, cc) + '.'\n                parts.append(pre + s if pre else s)\n            clear = [CUR[cc][0] for cc in ('TL', 'USD', 'EUR', 'GBP')
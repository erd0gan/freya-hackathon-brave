false,\n   \"truncation_window_size\": 10,\n   \"on_enter_first_entry_only\": false,\n   \"disable_inactivity_monitor\": false,\n   \"passthrough_default_transition\": null,\n   \"return_to_previous_on_interrupt\": false\n  },\n  \"collection\": {\n   \"name\": \"collection\",\n   \"tools\": [\n    {\n     \"type\": \"function\",\n     \"config\": {\n      \"timeoutMs\": 12000,\n      \"maxRetries\": 0\n     },\n     \"function\": {\n      \"name\": \"get_account\",\n      \"handler\": \"__function__:api_call\",\n      \"parameters\": {\n       \"type\": \"object\",\n       \"properties\": {\n        \"url\": {\n         \"type\": \"string\",\n         \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/get_account\"\n        },\n        \"body\": {\n         \"type\": \"object\",\n         \"required\": [],\n         \"properties\": {\n          \"customer_id\": {\n           \"type\": \"string\",\n           \"default\": \"{{customer_id}}\"\n          }\n         }\n        },\n        \"method\": {\n         \"type\": \"string\",\n         \"default\": \"POST\"\n        },\n        \"headers\": {\n         \"type\": \"object\",\n         \"properties\": {\n          \"Content-Type\": {\n           \"type\": \"string\",\n           \"default\": \"application/json\"\n          }\n         }\n        }\n       }\n      },\n      \"description\": \"The customer's late products. Call it once, before you say anything about the account.\"\n     }\n    },\n    {\n     \"type\": \"function\",\n     \"config\": {\n      \"timeoutMs\": 12000,\n      \"maxRetries\": 0\n     },\n     \"function\": {\n      \"name\": \"create_promise\",\n      \"handler\": \"__function__:api_call\",\n      \"parameters\": {\n       \"type\": \"object\",\n       \"properties\": {\n        \"url\": {\n         \"type\": \"string\",\n         \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/create_promise\"\n        },\n        \"body\": {\n         \"type\": \"object\",\n         \"required\": [\n          \"product_id\",\n          \"amount\",\n          \"date\"\n         ],\n         \"properties\": {\n          \"date\": {\n           \"type\": \"string\",\n           \"default\": \"{{date}}\",\n           \"description\": \"Payment date as YYYY-MM-DD.\"\n          },\n          \"amount\": {\n           \"type\": \"number\",\n           \"default\": \"{{amount}}\",\n           \"description\": \"Amount the customer will pay.\"\n          },\n          \"product_id\": {\n           \"type\": \"string\",\n           \"default\": \"{{product_id}}\",\n           \"description\": \"product_id from the account result, for example p1.\"\n          },\n          \"customer_id\": {\n           \"type\": \"string\",\n           \"default\": \"{{customer_id}}\"\n          }\n         }\n        },\n        \"method\": {\n         \"type\": \"string\",\n         \"default\": \"POST\"\n        },\n        \"headers\": {\n         \"type\": \"object\",\n         \"properties\": {\n          \"Content-Type\": {\n           \"type\": \"string\",\n           \"default\": \"application/json\"\n          }\n         }\n        }\n       }\n      },\n      \"description\": \"Record a payment promise. Call it only after the customer said yes to the read-back of amount and date.\"\n     }\n    },\n    {\n     \"type\": \"function\",\n     \"config\": {\n      \"timeoutMs\": 10000\n     },\n     \"function\": {\n      \"name\": \"end_call\",\n      \"handler\": \"__function__:end_call\",\n      \"parameters\": {\n       \"type\": \"object\",\n       \"properties\": {\n        \"message_mode\": {\n         \"type\": \"string\",\n         \"default\": \"none\"\n        },\n        \"interruptible\": {\n         \"type\": \"boolean\",\n         \"default\": true\n        },\n        \"trigger_pattern\": {\n         \"type\": \"string\",\n         \"default\": \"Have a good day|have a good day\"\n        },\n        \"trigger_timeout\": {\n         \"type\": \"number\",\n         \"default\": 3\n        },\n        \"trigger_pattern_both\": {\n         \"type\": \"string\",\n         \"default\": \"goodbye|bye|have a good day|you too|thank you|thanks|take care\"\n        }\n       }\n      },\n      \"description\": \"Ends the call. You normally do NOT call this: the phrase \\\"Have a good day.\\\" ends the call by itself. Call it without any text only if the customer answers after your goodbye.\"\n     }\n    }\n   ],\n   \"on_enter\": {\n    \"text\": \"Thank you, that's verified. I'm calling about your Freya Bank account, do you have a minute?\",\n    \"type\": \"tts\"\n   },\n   \"position\": {\n    \"x\": 500,\n    \"y\": 0\n   },\n   \"node_type\": \"conversation\",\n   \"assertions\": [],\n   \"passthrough\": false,\n   \"pre_actions\": [],\n   \"transitions\": [],\n   \"role_message\": \"\",\n   \"task_message\": \"You are the digital assistant of Freya Bank on a collection call. The customer is verified. Speak English, one or two short sentences per turn.\\nFirst call get_account, then tell the customer the past due amount and ask when they can pay it.\\nGet a payment date, read the amount and the date back, and call create_promise after the customer says yes.\\nWhen the promise is recorded or the customer will not pay, say goodbye, ending with \\\"Have a good day.\\\"\\nNow: {{now}}.\",\n   \"interruptible\": true,\n   \"max_node_turns\": 80,\n   \"response_mapping\": [],\n   \"extraction_schema\": [],\n   \"max_turn_transition\": null,\n   \"truncation_strategy\": \"keep_all\",\n   \"suppress_tool_results\": false,\n   \"truncation_window_size\": 10,\n   \"on_enter_first_entry_only\": false,\n   \"disable_inactivity_monitor\": false,\n   \"passthrough_default_transition\": null,\n   \"return_to_previous_on_interrupt\": false\n  }\n },\n \"tools\": [\n  {\n   \"type\": \"function\",\n   \"config\": {\n    \"timeoutMs\": 12000,\n    \"maxRetries\": 0,\n    \"alwaysRunsAt\": [\n     \"end_of_call\"\n    ]\n   },\n   \"function\": {\n    \"name\": \"close_call\",\n    \"handler\": \"__function__:api_call\",\n    \"parameters\": {\n     \"type\": \"object\",\n     \"properties\": {\n      \"url\": {\n       \"type\": \"string\",\n       \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/close_call\"\n      },\n      \"body\": {\n       \"type\": \"object\",\n       \"required\": [\n        \"outcome\"\n       ],\n       \"properties\": {\n        \"reason\": {\n         \"type\": \"string\",\n         \"default\": \"{{reason}}\",\n         \"description\": \"Leave out for promise. no_promise: refused. not_verified: failed (wrong answers) or declined (would not answer). not_reached: wrong_number or unclear.\"\n        },\n        \"outcome\": {\n         \"enum\": [\n          \"promise\",\n          \"no_promise\",\n          \"not_verified\",\n          \"not_reached\"\n         ],\n         \"type\": \"string\",\n         \"default\": \"{{outcome}}\",\n         \"description\": \"promise: a payment promise was recorded. no_promise: verified customer, no promise. not_verified: the identity check did not pass. not_reached: the right person was not on the line.\"\n        },\n        \"customer_id\": {\n         \"type\": \"string\",\n         \"default\": \"{{customer_id}}\"\n        }\n       }\n      },\n      \"method\": {\n       \"type\": \"string\",\n       \"default\": \"POST\"\n      },\n      \"headers\": {\n       \"type\": \"object\",\n       \"properties\": {\n        \"Content-Type\": {\n         \"type\": \"string\",\n         \"default\": \"application/json\"\n        }\n       }\n      }\n     }\n    },\n    \"description\": \"Record how the call ended, from the conversation.\"\n   },\n   \"pre_process_code\": \"try:\\n    b = config.get('body')\\n    if isinstance(b, dict) and b.get('outcome') in ('promise', 'paid'):\\n        b.pop('reason', None)\\nexcept Exception:\\n    pass\\n\"\n  }\n ],\n \"global_nodes\": {},\n \"initial_node\": \"identity\",\n \"system_prompt\": \"\",\n \"test_variables\": {\n  \"first_name\": \"Daniel\",\n  \"last_name\": \"Reyes\",\n  \"title\": \"Mr\",\n  \"now\": \"2026-10-14T11:00\"\n }\n}","numLines":407,"startLine":1,"totalLines":407}}}

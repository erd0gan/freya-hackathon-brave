isin, Türkçe konuşuyorsun. İlk cümlen: 'Kredi faiz oranlarınız ne kadar?' Ana menüye aktarılmak isteyip istemediğin sorulunca 'Hayır, borcumu öğrenmek istiyorum' de. Borcu dinleyince 'teşekkürler' de.\",\n  \"successCriteria\": \"Asistan 'Size bu konuda yardımcı olamıyorum. Sizi ana menüye aktarmamı ister misiniz?' diye sorar, faiz oranı söylemez. Hayır denince borç okumaya devam eder.\",\n  \"variables\": {\"customerNumber\": \"95004361\", \"now\": \"2026-10-12T10:30:00+03:00\"}},\n {\"name\": \"english_caller\",\n  \"prompt\": \"You are a Freya Bank customer who speaks only English. Say: 'Hello, I want to know my credit card debt, do you speak English?'\",\n  \"successCriteria\": \"Asistan Türkçe dışı konuşma için 'Sizi ana menüye aktarıyorum.' der ve aktarır.\",\n  \"variables\": {\"customerNumber\": \"95004361\", \"now\": \"2026-10-12T10:30:00+03:00\"}},\n {\"name\": \"email_service_error\",\n  \"prompt\": \"Sen Freya Bank müşterisisin, Türkçe konuşuyorsun. 'Borcumu öğrenmek istiyorum' de. Borcu dinleyince 'Ekstremi mailime gönderin' de.\",\n  \"successCriteria\": \"Borç okunur. E-posta servisi hata verdiği için 'Şu anda işleminizi gerçekleştiremiyorum, sizi müşteri temsilcimize aktarıyorum.' denir; gönderildi denmez.\",\n  \"variables\": {\"customerNumber\": \"92335586\", \"now\": \"2026-10-12T10:30:00+03:00\"}}\n]\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":819,"cache_read_input_tokens":152624,"cache_creation":{"ephemeral_5m_input_tokens":819,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"adf52405-6942-4d44-9d85-c3233da23ca1","uuid":"aba1e38a-4c55-473f-a3ec-2f85e55329b5","timestamp":"2026-10-11T19:24:24.774Z","request_id":"req_011CfvzkHaZg2r9BQ5Seuyo2"}

(10**6, 'milyon'), (1000, 'bin')):\n        q, n = divmod(n, val)\n        if q:\n            parts.append('bin' if (val == 1000 and q == 1) else w3(q) + ' ' + name)\n    if n:\n        parts.append(w3(n))\n    return ' '.join(parts)\nCUR = {'TL': ('Türk Lirası', 'lira', 'kuruş'), 'USD': ('Dolar', 'dolar', 'sent'), 'EUR': ('Euro', 'euro', 'sent'), 'GBP': ('İngiliz Sterlini', 'sterlin', 'peni')}\ndef money(x, c):\n    full, unit, sub = CUR[c]\n    cents = int(round(abs(float(x)) * 100))\n    a, b = divmod(cents, 100)\n    if b == 0:\n        return words(a) + ' ' + full\n    return words(a) + ' ' + unit + ' ' + words(b) + ' ' + sub\ndef pdate(s):\n    try:\n        d, m, y = str(s).strip().split('.')\n        return datetime.date(int(y), int(m), int(d))\n    except Exception:\n        return None\ndef sdate(s):\n    d = pdate(s)\n    if not d:\n        return str(s)\n    return str(d.day) + ' ' + MONTHS[d.month] + ' ' + str(d.year)\ndef suffix_dir(s):\n    d = pdate(s)\n    last = words(d.year).split()[-1] if d else 'altı'\n    vow = [ch for ch in last if ch in 'aeıioöuü']\n    v = vow[-1] if vow else 'a'\n    hv = {'a': 'ı', 'ı': 'ı', 'e': 'i', 'i': 'i', 'o': 'u', 'u': 'u', 'ö': 'ü', 'ü': 'ü'}[v]\n    c = 't' if last[-1] in 'fstkçşhp' else 'd'\n    return \"'\" + c + hv + 'r'\ndef digits(s):\n    return ' '.join(DIG[int(ch)] for ch in str(s) if ch.isdigit())\ndef today():\n    try:\n        return datetime.date.fromisoformat(str(vars.get('now') or '')[:10])\n    except Exception:\n        return datetime.date.today()\ndef num(b, k):\n    try:\n        return float((b or {}).get(k) or 0)\n    except Exception:\n        return 0.0\ndef body_of(result):\n    d = result.get('data') if isinstance(result, dict) else None\n    if isinstance(d, str):\n        try:\n            d = json.loads(d)\n        except Exception:\n            d = None\n    return d if isinstance(d, dict) else {}\ndef ok_of(result):\n    b = body_of(result)\n    sc = result.get('status_code') if isinstance(result, dict) else None\n    try:\n        sc = int(sc)\n    except Exception:\n        sc = 0\n    rc = str((b.get('result') or {}).get('returnCode') or '')\n    return (sc == 200 and rc == '1' and isinstance(b.get('data'), dict)), sc, b\ndef norm(s):\n    s = str(s or '').replace('İ', 'i').replace('I', 'ı').lower()\n    s = s.replace('â', 'a')\n    return re.sub(r'[^0-9a-zçğıöşü ]', ' ', s)\n'''\n\n\ndef pre(body_py):\n    \"\"\"pre-hook: send the bank envelope, built from vars.\"\"\"\n    return LIB + \"try:\\n    d = \" + body_py + \"\\n    config['body'] = json.dumps(dict(data=d, call=dict(ani='', lang='tr')), ensure_ascii=False)\\n    config['headers'] = dict(config.get('headers') or dict())\\n    config['headers']['Content-Type'] = 'application/json'\\n    config['headers']['Accept'] = 'application/json'\\n    config['headers']['Authorization'] = 'Bearer test'\\nexcept Exception:\\n    pass\\n\"\n\n\ndef api(name, path, body_py, post_py, timeout=20000, retries=1):\n    return {\n        \"type\": \"function\",\n        \"config\": {\"timeoutMs\": timeout, \"maxRetries\": retries},\n        \"function\": {\n            \"name\": name,\n            \"handler\": \"__function__:api_call\",\n            \"description\": \"Bank service \" + path,\n            \"parameters\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"url\": {\"type\": \"string\", \"default\": BASE + path},\n                    \"method\": {\"type\": \"string\", \"default\": \"POST\"},\n                    \"connect_retries\": {\"type\": \"number\", \"default\": 2},\n                    \"headers\": {\"type\": \"object\", \"properties\": {\n                        \"Content-Type\": {\"type\": \"string\", \"default\": \"application/json\"},\n                        \"Accept\": {\"type\": \"string\", \"default\": \"application/json\"},\n                        \"Authorization\": {\"type\": \"string\", \"default\": \"Bearer test\"}}},\n                    \"body\": {\"type\": \"object\", \"properties\": {\n                        \"data\": {\"type\": \"object\", \"default\": {}},\n                        \"call\": {\"type\": \"object\", \"default\": {\"ani\": \"\", \"lang\": \"tr\"}}}},\n                },\n            },\n        },\n        \"pre_process_code\": pre(body_py),\n        \"post_process_code\": LIB + \"try:\\n\" + \"\\n\".join(\"    \" + l for l in post_py.strip(\"\\n\").split(\"\\n\")) + \"\\nexcept Exception as e:\\n    vars['svc_error'] = str(e)[:200]\\n\",\n    }\n\n\ndef cond(var, op, val=None):\n    c = {\"variable\": var, \"operator\": op}\n    if val is not None:\n        c[\"operand\"] = val\n    return {\"logic\": \"or\", \"conditions\": [c]}\n\n\ndef T(target, c, desc=\"\"):\n    return {\"target_node\": target, \"description\": desc or target, \"condition\": c}\n\n\nALWAYS = {\"operator\": \"always\"}\n\n\ndef code_node(name, code, transitions, on_enter=None):\n    return {\n        \"name\": name, \"node_type\": \"code\", \"passthrough\": True,\n        \"passthrough_default_transition\": transitions[-1][\"target_node\"],\n        \"on_enter\": on_enter or {\"type\": \"silent\"}, \"disable_inactivity_monitor\": True,\n        \"pre_actions\": [{\"type\": \"function\", \"function\": {\"name\": \"code_exec\", \"handler\": \"__function__:code_exec\",\n                         \"parameters\": {\"type\": \"object\", \"properties\": {\n                             \"code\": {\"type\": \"string\", \"default\": LIB + \"try:\\n\" + \"\\n\".join(\"    \" + l for l in code.strip(\"\\n\").split(\"\\n\")) + \"\\nexcept Exception as e:\\n    vars['code_error'] = str(e)[:200]\\n\"},\n                             \"timeout_ms\": {\"type\": \"number\", \"default\": 10000}}}}}],\n        \"transitions\": transitions,\n    }\n\n\ndef api_node(name, tool, transitions, on_enter=None):\n    return {\n        \"name\": name, \"node_type\": \"api_request\", \"passthrough\": True,\n        \"passthrough_default_transition\": transitions[-1][\"target_node\"],\n        \"on_enter\": on_enter or {\"type\": \"silent\"}, \"disable_inactivity_monitor\": True,\n        \"suppress_tool_results\": True,\n        \"pre_actions\": [tool], \"transitions\": transitions,\n    }\n\n\ndef end(name, fn, msg):\n    return {\"name\": name, \"node_type\": \"end_call\", \"on_enter\": {\"type\": \"silent\"}, \"disable_inactivity_monitor\": True,\n            \"transitions\": [], \"terminal\": {\"type\": \"function\", \"function\": {\"name\": fn, \"handler\": \"__function__:end_call\",\n            \"parameters\": {\"type\": \"object\", \"properties\": {\"message_mode\": {\"type\": \"string\", \"default\": \"custom\"},\n                                                             \"spoken_message\": {\"type\": \"string\", \"default\": msg}}}}}}\n\n\nNODES = {}\n\n# ---------------------------------------------------------------- start\nNODES[\"start\"] = code_node(\"start\", r'''\nvars['today_iso'] = today().isoformat()\nvars['card_tries'] = 0\nvars['anger_count'] = 0\nvars['silence_count'] = 0\nvars['email_loaded'] = 'no'\nvars['send_count'] = 0\nvars['cand_json'] = ''\nvars['read_count'] = 0\n''', [T(\"load_cards\", ALWAYS)])\n\n# ---------------------------------------------------------------- cards.list\nCARDS_POST = r'''\nok, sc, b = ok_of(result)\nif ok:\n    cards = b['data'].get('cards') or []\n    vars['cards_json'] = json.dumps(cards, ensure_ascii=False)\n    vars['card_count'] = str(len(cards))\n    if len(cards) == 0:\n        vars['cards_state'] = 'nocard'\n    elif len(cards) == 1:\n        c = cards[0]\n        vars['cards_state'] = 'one'\n        vars['sel_card'] = c.get('cardNumber') or ''\n        vars['sel_last4'] = c.get('cardNumberLast4') or ''\n        vars['sel_name'] = (c.get('productName') or '').strip()\n    else:\n        vars['cards_state'] = 'multi'\n        names = []\n        for c in cards:\n            n = (c.get('productName') or '').strip()\n            if n and n not in names and c.get('isMainCard') is not False:\n                names.append(n)\n        ex = names[:2]\n        if len(ex) >= 2:\n            q = 'Hangi kartınızın borcunu öğrenmek istersiniz? Örneğin, ' + ex[0] + ' veya ' + ex[1] + ' diyebilirsiniz.'\n        elif ex:\n            q = 'Hangi kartınızın borcunu öğrenmek istersiniz? Örneğin, ' + ex[0] + ' diyebilirsiniz.'\n        else:\n            q = 'Hangi kartınızın borcunu öğrenmek istersiniz? Kartınızın son dört hanesini söyleyebilirsiniz.'\n        vars['card_prompt'] = q\n        vars['card_question'] = q\n        vars['card_names'] = ', '.join(names)\nelif sc == 404 and str((b.get('result') or {}).get('code') or '') == 'FB_IVR_CHANNEL_102':\n    vars['cards_state'] = 'nocard'\nelse:\n    vars['cards_state'] = 'error'\n'''\nNODES[\"load_cards\"] = api_node(\"load_cards\", api(\"cards_list\", \"/cards.list\",\n    \"dict(customerNo=str(vars.get('customerNumber') or ''), aiFlow='CardOps')\", CARDS_POST), [\n    T(\"end_nocard\", cond(\"cards_state\", \"equals\", \"nocard\")),\n    T(\"load_balance\", cond(\"cards_state\", \"equals\", \"one\")),\n    T(\"choose_card\", cond(\"cards_state\", \"equals\", \"multi\")),\n    T(\"end_error\", ALWAYS)])\n\n# ---------------------------------------------------------------- card choice\nNODES[\"choose_card\"] = {\n    \"name\": \"choose_card\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"{{card_prompt}}\"},\n    \"task_message\": \"You are asking which card the caller wants. The caller's eligible cards: {{card_names}}. Do not call any tool. If the caller asks to hear the question again, repeat exactly: \\\"{{card_question}}\\\". Never say card names the caller does not have, and never say any card digits other than the last four. Never read several cards' debt at once.\",\n    \"extraction_schema\": [{\n        \"name\": \"card_query\", \"type\": \"string\", \"min_confidence\": 0.4,\n        \"description\": \"From the caller's LAST message only: the card they choose. Either the card name as said (e.g. 'Yıldız Premium', 'premium', 'fly') or the card digits written as plain digits (e.g. 'dört iki beş üç' -> 4253, 'kırk iki elli üç' -> 4253, a full number -> all its digits). Write ALL if they ask for all cards at once. Write NOCARD if they say they don't have the card / don't know. Empty if the last message names no card.\"}],\n    \"transitions\": [T(\"resolve_card\", cond(\"card_query\", \"is_set\"), \"The caller said something about the card\")],\n}\n\nRESOLVE = r'''\nq = str(vars.get('card_query') or '').strip()\nvars['card_query'] = ''\ncards = json.loads(vars.get('cards_json') or '[]')\ncand = json.loads(vars.get('cand_json') or 'null') if vars.get('cand_json') else None\npool = cand if cand else cards\nnames_all = vars.get('card_names') or ''\nstate = 'retry'\nmsg = ''\ndg = re.sub(r'[^0-9]', '', q)\nif not dg:\n    nq = norm(q)\n    m = dict(sıfır='0', bir='1', iki='2', üç='3', dört='4', beş='5', altı='6', yedi='7', sekiz='8', dokuz='9')\n    toks = nq.split()\n    if toks and all(t in m for t in toks):\n        dg = ''.join(m[t] for t in toks)\npicked = None\nif q == '' or q.upper() == 'NONE':\n    state = 'ask'\nelif q.upper() == 'ALL':\n    msg = 'Borç bilgisini kart kart verebiliyorum. ' + vars.get('card_question', '')\nelif q.upper() == 'NOCARD':\n    msg = 'Kartınızın adını söyleyebilirsiniz. ' + vars.get('card_question', '')\nelif len(dg) >= 4:\n    l4 = dg[-4:]\n    hits = [c for c in pool if str(c.get('cardNumberLast4')) == l4]\n    if len(dg) >= 12:\n        f6 = dg[:6]\n        h2 = [c for c in hits if str(c.get('cardNumber', ''))[:6] == f6]\n        hits = h2 if h2 else []\n    if len(hits) == 1:\n        picked = hits[0]\n    elif len(hits) > 1 and len(dg) < 6:\n        state = 'ambig'\n        vars['cand_json'] = json.dumps(hits, ensure_ascii=False)\n        msg = 'Son dört hanesi ' + digits(l4) + ' olan birden fazla kartınız var. Kartınızın son altı hanesini söyler misiniz?'\n    elif len(hits) > 1:\n        state = 'ambig'\n        vars['cand_json'] = json.dumps(hits, ensure_ascii=False)\n        msg = 'Son altı hanesi aynı olan birden fazla kartınız var. Kart numaranızı söyler misiniz?'\n    else:\n        msg = 'Bu numarayla eşleşen bir kartınız bulunmuyor. ' + vars.get('card_question', '')\nelse:\n    nq = norm(q).strip()\n    exact = [c for c in pool if norm(c.get('productName')).strip() == nq and nq]\n    if exact:\n        hits = exact\n    else:\n        qt = [t for t in nq.split() if t not in ('kart', 'kartım', 'kartımın', 'kartı', 'kartımı')]\n        hits = [c for c in pool if qt and all(t in norm(c.get('productName')).split() or any(w.startswith(t) for w in norm(c.get('productName')).split()) for t in qt)]\n        if not hits and qt:\n            hits = [c for c in pool if any(t != 'yıldız' and any(w.startswith(t) for w in norm(c.get('productName')).split()) for t in qt)]\n    if len(hits) == 1:\n        picked = hits[0]\n    elif len(hits) > 1:\n        hn = []\n        for c in hits:\n            n = (c.get('productName') or '').strip()\n            if n not in hn:\n                hn.append(n)\n        vars['cand_json'] = json.dumps(hits, ensure_ascii=False)\n        state = 'ambig'\n        if len(hn) == 1:\n            msg = hn[0] + ' isimli birden fazla kartınız var. Kartınızın son dört hanesini söyler misiniz?'\n        else:\n            msg = 'Hangi kartınızı kastettiniz? ' + ' veya '.join(hn) + ' diyebilirsiniz.'\n    else:\n        msg = 'Bu isimde bir kartınız bulunmuyor. Kartlarınız: ' + names_all + '. Hangisinin borcunu öğrenmek istersiniz?'\nif picked is not None and picked.get('isMainCard') is False:\n    picked = None\n    state = 'retry'\n    msg = 'Bu kart için borç bilgisi veremiyorum. Lütfen başka bir kartınızı seçin. ' + vars.get('card_question', '')\nif picked is not None:\n    vars['sel_card'] = picked.get('cardNumber') or ''\n    vars['sel_last4'] = picked.get('cardNumberLast4') or ''\n    vars['sel_name'] = (picked.get('productName') or '').strip()\n    vars['cand_json'] = ''\n    vars['card_tries'] = 0\n    state = 'ok'\nelif state == 'ask':\n    vars['card_prompt'] = vars.get('card_question', '')\nelse:\n    vars['card_tries'] = int(vars.get('card_tries') or 0) + 1\n    vars['card_prompt'] = msg\n    if vars['card_tries'] >= 3:\n        state = 'tries'\nvars['resolve_state'] = state\n'''\nNODES[\"resolve_card\"] = code_node(\"resolve_card\", RESOLVE, [\n    T(\"load_balance\", cond(\"resolve_state\", \"equals\", \"ok\")),\n    T(\"end_tries\", cond(\"resolve_state\", \"equals\", \"tries\")),\n    T(\"choose_card\", ALWAYS)])\n\n# ---------------------------------------------------------------- balance\nBAL_POST = r'''\nok, sc, b = ok_of(result)\nif not ok:\n    vars['bal_state'] = 'error'\nelse:\n    d = b['data']\n    vars['bal_state'] = 'ok'\n    vars['stmt_date'] = d.get('statementDate') or ''\n    vars['bal_json'] = json.dumps(d, ensure_ascii=False)\n'''\nNODES[\"load_balance\"] = api_node(\"load_balance\", api(\"cards_balance\", \"/cards.balance\",\n    \"dict(cardNumber=str(vars.get('sel_card') or ''))\", BAL_POST), [\n    T(\"load_email\", {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [\n        {\"variable\": \"bal_state\", \"operator\": \"equals\", \"operand\": \"ok\"},\n        {\"variable\": \"email_loaded\", \"operator\": \"equals\", \"operand\": \"no\"}]}]}),\n    T(\"build_reading\", cond(\"bal_state\", \"equals\", \"ok\")),\n    T(\"end_error\", ALWAYS)], on_enter={\"type\": \"silent\"})\n\nEMAIL_POST = r'''\nok, sc, b = ok_of(result)\nif not ok:\n    vars['email_state'] = 'error'\nelse:\n    d = b['data']\n    em = str(d.get('ibanEmail') or '').strip()\n    if em and str(d.get('communicationType') or '') != 'Phone':\n        vars['email_state'] = 'has'\n        vars['reg_email'] = em\n        local, _, dom = em.partition('@')\n        messy = len(local) > 14 or len(re.findall(r'[0-9._-]', local)) > 1\n        if messy:\n            vars['email_spoken'] = local[0] + ' ile başlayan ' + dom.split('.')[0] + ' uzantılı'\n        else:\n            vars['email_spoken'] = em\n    else:\n        vars['email_state'] = 'none'\n        vars['reg_email'] = ''\nvars['email_loaded'] = 'yes'\n'''\nNODES[\"load_email\"] = api_node(\"load_email\", api(\"contact_email\", \"/contact.email.get\",\n    \"dict(customerNo=str(vars.get('customerNumber') or ''), intAddressInfoType='E')\", EMAIL_POST), [\n    T(\"end_error\", cond(\"email_state\", \"equals\", \"error\")),\n    T(\"build_reading\", ALWAYS)])\n\nBUILD = r'''\nd = json.loads(vars.get('bal_json') or '{}')\nt = today()\nlast4 = str(vars.get('sel_last4') or d.get('cardNumberLast4') or '')\nname = str(vars.get('sel_name') or d.get('productName') or '').strip()\nintro = 'Sonu ' + digits(last4) + ' ile biten ' + (name + ' kartınıza' if name else 'kartınıza') + ' ait '\nintro_k = 'Sonu ' + digits(last4) + ' ile biten ' + (name + ' kartınızın' if name else 'kartınızın') + ' '\nsd = pdate(d.get('statementDate'))\nlp = pdate(d.get('lastPayDate'))\nblocks = [('TL', 'debtTL'), ('USD', 'debtUSD'), ('EUR', 'debtEUR'), ('GBP', 'debtGBP')]\npresent = [(c, d.get(k)) for c, k in blocks if isinstance(d.get(k), dict) and d.get(k)]\ns = []\nif not sd:\n    s.append(intro_k + 'henüz kesilmiş bir ekstresi bulunmadığından ekstre borcunuz bulunmamaktadır.')\nelif sd == t:\n    s.append(intro_k + 'hesap kesim tarihi bugün, ekstreniz saat 00.00 itibarıyla kesilecek.')\n    tot = [CUR[c][0] + ' toplam borcunuz ' + money(num(bl, 'totalDebt'), c) for c, bl in present if num(bl, 'totalDebt') > 0]\n    if tot:\n        s.append(', '.join(tot) + 'dir.' if False else ', '.join(tot) + '.')\n    else:\n        s.append('Borcunuz bulunmamaktadır.')\nelif str(d.get('statementPaymentStatus')) == 'NO_DEBT':\n    g = num(d.get('debtTL'), 'totalDebt')\n    line = intro_k + sdate(d.get('statementDate')) + ' tarihli ekstresinden borcunuz bulunmamaktadır.'\n    if g > 0:\n        line += ' Gelecek dönemler dahil toplam borcunuz ' + money(g, 'TL') + \"'dir.\"\n    if lp:\n        line += ' Son ödeme tarihiniz ' + sdate(d.get('lastPayDate')) + ' olacaktır.'\n    s.append(line)\nelif lp and t > lp:\n    s.append(intro + sdate(d.get('statementDate')) + ' tarihinde kesilen ekstrenizin son ödeme tarihi olan ' + sdate(d.get('lastPayDate')) + ' geçmiştir.')\n    tot = [CUR[c][0] + ' toplam borcunuz ' + money(num(bl, 'totalDebt'), c) for c, bl in present if num(bl, 'totalDebt') > 0]\n    if tot:\n        s.append(', '.join(tot) + '.')\n    clear = [CUR[c][0] for c, bl in present if num(bl, 'totalDebt') <= 0]\n    if clear and tot:\n        s.append((', '.join(clear[:-1]) + ' ve ' + clear[-1] if len(clear) > 1 else clear[0]) + ' borcunuz bulunmamaktadır.')\n    ra = num(d.get('debtTL'), 'remainAutomaticPaymentAmount')\n    if str(d.get('automaticPaymentFlag')) == 'Y' and ra > 0:\n        s.append('Otomatik ödeme talimatınızdan tahsil edilecek kalan tutar ' + money(ra, 'TL') + \"'dir.\")\nelse:\n    first = True\n    pre_txt = intro + sdate(d.get('statementDate')) + ' tarihinde kesilen ekstre '\n    clear = []\n    transfers = [CUR[c][0] for c, bl in present if c != 'TL' and num(bl, 'transferAmount') > 0]\n    for c, bl in present:\n        rem = num(bl, 'remainingDebt')\n        if rem <= 0:\n            clear.append(CUR[c][0])\n            continue\n        X = money(num(bl, 'statementDebt'), c)\n        Z = money(num(bl, 'minPayment'), c)\n        Y = money(rem, c)\n        TT = money(num(bl, 'remainingMinPayment'), c)\n        rmin = num(bl, 'remainingMinPayment')\n        mn = num(bl, 'minPayment')\n        if c == 'TL':\n            if transfers:\n                lead = ('ve '.join(transfers) if len(transfers) < 3 else ', '.join(transfers)) + ' borcunuzun bir kısmı Türk Lirası borcunuza aktarılmıştır. '\n            else:\n                lead = ''\n            if rmin <= 0:\n                line = 'Türk Lirası borcunuz ' + X + ', kalan toplam borcunuz ' + Y + \"'dir. Minimum ödemenizi yaptığınız için teşekkür ederiz.\"\n            elif rmin >= mn:\n                line = 'Türk Lirası borcunuz ' + X + ', ödenmesi gereken minimum tutar ' + Z + \"'dir.\"\n            else:\n                line = 'Türk Lirası borcunuz ' + X + ', ödenmesi gereken minimum tutar ' + Z + ', kalan toplam borcunuz ' + Y + ', kalan minimum ödeme tutarınız ' + TT + \"'dir.\"\n            line = lead + line\n        else:\n            line = CUR[c][0] + ' borcunuz ' + X + ', kalan toplam borcunuz ' + Y + ', ödenmesi gereken minimum tutar ' + Z + \"'dir.\"\n        if first:\n            line = pre_txt + line[0].lower() + line[1:] if line.startswith('Türk') is False and line.startswith('Dolar') is False and line.startswith('Euro') is False and line.startswith('İngiliz') is False else pre_txt + line\n            first = False\n        s.append(line)\n    if clear and not first:\n        s.append((', '.join(clear[:-1]) + ' ve ' + clear[-1] if len(clear) > 1 else clear[0]) + ' borcunuz bulunmamaktadır.')\n    elif first:\n        s.append(intro_k + sdate(d.get('statementDate')) + ' tarihli ekstresinden borcunuz bulunmamaktadır.')\n    if lp:\n        if lp == t:\n            s.append('Borçlarınız için son ödeme tarihiniz bugündür.')\n        else:\n            s.append('Borçlarınız için son ödeme tarihiniz ' + sdate(d.get('lastPayDate')) + suffix_dir(d.get('lastPayDate')) + '.')\ndef sfxw(w):\n    base = words(int(w)).split()[-1] if w.isdigit() else w.lower()\n    vow = [ch for ch in base if ch in 'aeıioöuü']\n    v = vow[-1] if vow else 'a'\n    hv = dict(a='ı', ı='ı', e='i', i='i', o='u', u='u', ö='ü', ü='ü')[v]\n    c = 't' if base[-1] in 'fstkçşhp' else 'd'\n    return w + \"'\" + c + hv + 'r'\nvars['reading_text'] = re.sub(r\"(\\w+)'dir\", lambda m: sfxw(m.group(1)), ' '.join(s))\nmulti = int(vars.get('card_count') or 1) > 1\nhas_mail = vars.get('email_state') == 'has'\nif has_mail:\n    offer = 'Hesap kesim tarihinizi değiştirebilirim ya da ekstrenizi kayıtlı mail adresinize gönderebilirim. Başka bir işlem yapmak ister misiniz?'\nelse:\n    offer = 'Hesap kesim tarihinizi değiştirebilirim. Başka bir işlem yapmak ister misiniz?'\nvars['offer_text'] = offer\nvars['multi'] = 'yes' if multi else 'no'\nvars['after_text'] = 'Başka bir kartınızın borcunu öğrenmek ister misiniz?' if multi else offer\nvars['stage'] = 'other_card' if multi else 'offer'\nvars['next_action'] = 'unclear'\nvars['offer_choice'] = 'unclear'\nvars['read_count'] = int(vars.get('read_count') or 0) + 1\n'''\nNODES[\"build_reading\"] = code_node(\"build_reading\", BUILD, [T(\"read_debt\", ALWAYS)])\n\nNODES[\"read_debt\"] = {\n    \"name\": \"read_debt\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"{{reading_text}} {{after_text}}\"},\n    \"task_message\": (\n        \"You just read the caller's statement debt. Do not call any tool. Reading (repeat it word for word if the caller asks to hear it again): \\\"{{reading_text}}\\\"\\n\"\n        \"Your last question was: \\\"{{after_text}}\\\"\\n\"\n        \"If the caller's answer is unclear, ask that question again in one short sentence. Never give any amount, date or rate that is not in the reading. Never say card digits other than the last four.\"),\n    \"extraction_schema\": [{\n        \"name\": \"next_action\", \"type\": \"string\", \"min_confidence\": 0.5,\n        \"enum_values\": [\"other_card\", \"email\", \"week\", \"done\", \"yes\", \"no\", \"repeat\", \"unclear\"],\n        \"description\": \"What the caller wants now, from their LAST message. other_card = debt of another of their own cards; email = statement sent by e-mail (any statement, any month); week = change the statement date/week (hesap kesim tarihi); done = nothing else, thanks, goodbye; yes = a bare yes to the last question; no = a bare no; repeat = wants to hear it again; unclear = anything else.\"}],\n    \"transitions\": [\n        T(\"choose_again\", {\"logic\": \"or\", \"conditions\": [{\"variable\": \"next_action\", \"operator\": \"equals\", \"operand\": \"other_card\"},\n            {\"logic\": \"and\", \"conditions\": [{\"variable\": \"next_action\", \"operator\": \"equals\", \"operand\": \"yes\"}, {\"variable\": \"stage\", \"operator\": \"equals\", \"operand\": \"other_card\"}]}]}),\n        T(\"email_route\", cond(\"next_action\", \"equals\", \"email\")),\n        T(\"load_week\", cond(\"next_action\", \"equals\", \"week\")),\n        T(\"show_offer\", {\"logic\": \"or\", \"conditions\": [{\"logic\": \"and\", \"conditions\": [{\"variable\": \"next_action\", \"operator\": \"equals\", \"operand\": \"no\"}, {\"variable\": \"stage\", \"operator\": \"equals\", \"operand\": \"other_card\"}]}]}),\n        T(\"end_menu\", {\"logic\": \"or\", \"conditions\": [{\"variable\": \"next_action\", \"operator\": \"equals\", \"operand\": \"done\"}, {\"variable\": \"next_action\", \"operator\": \"equals\", \"operand\": \"no\"}]}),\n    ],\n    \"max_node_turns\": 6, \"max_turn_transition\": \"end_tries\",\n}\n\nNODES[\"choose_again\"] = code_node(\"choose_again\", r'''\nvars['card_prompt'] = vars.get('card_question', '')\nvars['cand_json'] = ''\nvars['card_tries'] = 0\nvars['card_query'] = ''\n''', [T(\"choose_card\", ALWAYS)])\n\nNODES[\"show_offer\"] = {\n    \"name\": \"show_offer\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"{{offer_text}}\"},\n    \"task_message\": \"You offered: \\\"{{offer_text}}\\\". Do not call any tool. If the answer is unclear, ask the offer again in one short sentence. Never give any amount or date.\",\n    \"extraction_schema\": [{\n        \"name\": \"offer_choice\", \"type\": \"string\", \"min_confidence\": 0.5,\n        \"enum_values\": [\"email\", \"week\", \"done\", \"other_card\", \"unclear\"],\n        \"description\": \"From the caller's LAST message: email = wants the statement by e-mail; week = change the statement date/week; done = no, nothing else, thanks; other_card = another card's debt; unclear = anything else.\"}],\n    \"transitions\": [\n        T(\"email_route\", cond(\"offer_choice\", \"equals\", \"email\")),\n        T(\"load_week\", cond(\"offer_choice\", \"equals\", \"week\")),\n        T(\"choose_again\", cond(\"offer_choice\", \"equals\", \"other_card\")),\n        T(\"end_menu\", cond(\"offer_choice\", \"equals\", \"done\")),\n    ],\n    \"max_node_turns\": 4, \"max_turn_transition\": \"end_tries\",\n}\n\n# ---------------------------------------------------------------- e-mail\nNODES[\"email_route\"] = code_node(\"email_route\", \"vars['email_r'] = vars.get('email_state') or 'none'\", [\n    T(\"email_confirm\", cond(\"email_r\", \"equals\", \"has\")),\n    T(\"no_email\", ALWAYS)])\nNODES[\"no_email\"] = {\n    \"name\": \"no_email\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"Bankamızda kayıtlı bir e-posta adresiniz bulunmadığı için ekstrenizi gönderemiyorum. Hesap kesim tarihinizi değiştirebilirim. Bunu ister misiniz?\"},\n    \"task_message\": \"You said no statement can be sent because no e-mail is registered, and offered the statement week change. Do not call any tool. If unclear, ask once more whether they want to change the statement date.\",\n    \"extraction_schema\": [{\"name\": \"noemail_choice\", \"type\": \"string\", \"min_confidence\": 0.5, \"enum_values\": [\"week\", \"done\", \"unclear\"],\n                           \"description\": \"From the LAST message: week = yes, change the statement date; done = no / nothing else; unclear otherwise.\"}],\n    \"transitions\": [T(\"load_week\", cond(\"noemail_choice\", \"equals\", \"week\")), T(\"end_menu\", cond(\"noemail_choice\", \"equals\", \"done\"))],\n    \"max_node_turns\": 4, \"max_turn_transition\": \"end_tries\",\n}\nNODES[\"email_confirm\"] = {\n    \"name\": \"email_confirm\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"Yalnızca son ekstrenizi, bankamızda kayıtlı e-posta adresinize gönderebilirim. Ekstrenizi {{email_spoken}} adresine göndermemi ister misiniz?\"},\n    \"task_message\": \"You asked whether to send the latest statement to the registered address ({{email_spoken}}). Do not call any tool. Only the latest statement can be sent, only to the registered address; no other address, earlier month, paper or SMS. The address cannot be changed on this call. Never spell the address letter by letter. If the answer is not a clear yes or no, ask plainly: \\\"Ekstrenizi kayıtlı e-posta adresinize göndermemi onaylıyor musunuz?\\\" Never say the statement was sent.\",\n    \"extraction_schema\": [{\"name\": \"email_ok\", \"type\": \"string\", \"min_confidence\": 0.5, \"enum_values\": [\"yes\", \"no\", \"not_mine\", \"unclear\"],\n                           \"description\": \"From the LAST message: yes = clear yes/evet/gönder/okay send the latest statement; no = no; not_mine = the address is not theirs any more or they want another address; unclear = hedged or anything else.\"}],\n    \"transitions\": [\n        T(\"send_pdf\", cond(\"email_ok\", \"equals\", \"yes\")),\n        T(\"end_not_mine\", cond(\"email_ok\", \"equals\", \"not_mine\")),\n        T(\"end_menu\", cond(\"email_ok\", \"equals\", \"no\"))],\n    \"max_node_turns\": 3, \"max_turn_transition\": \"end_tries\",\n}\nPDF_POST = r'''\nok, sc, b = ok_of(result)\nvars['pdf_state'] = 'ok' if ok else 'error'\nvars['send_count'] = int(vars.get('send_count') or 0) + 1\n'''\nPDF_BODY = (\"dict(customerNo=str(vars.get('customerNumber') or ''), cardNumber=str(vars.get('sel_card') or ''), \"\n            \"currencyType='TL', statementDate=str(vars.get('stmt_date') or ''), emailAddress=str(vars.get('reg_email') or ''))\")\nNODES[\"send_pdf\"] = api_node(\"send_pdf\", api(\"statement_pdf_send\", \"/statement.pdf.send\", PDF_BODY, PDF_POST, retries=0), [\n    T(\"end_sent\", cond(\"pdf_state\", \"equals\", \"ok\")),\n    T(\"end_error\", ALWAYS)])\n\n# ---------------------------------------------------------------- statement week\nWEEK_POST = r'''\nok, sc, b = ok_of(result)\nif not ok:\n    vars['week_state'] = 'error'\nelse:\n    d = b['data']\n    vars['week_state'] = 'ok'\n    cw = int(d.get('statementWeek') or 0)\n    vars['cur_week'] = str(cw)\n    vars['stmt_day'] = str(d.get('statementDay') or '')\n    name = str(d.get('productName') or vars.get('sel_name') or '').strip()\n    l4 = str(d.get('cardNumberLast4') or vars.get('sel_last4') or '')\n    nm = (name + ' kartınızın') if name else ('Sonu ' + digits(l4) + ' ile biten kartınızın')\n    txt = nm + ' hesap kesim tarihi her ayın ' + str(cw) + '. haftası olarak tanımlı. Bir sonraki hesap kesim tarihiniz ' + sdate(d.get('nextStatementDate')) + ', son ödeme tarihiniz ' + sdate(d.get('nextLastPayDate')) + '.'\n    rel = str(d.get('relationType') or '')\n    rn = str(d.get('relatedCardProductName') or '').strip()\n    rnum = str(d.get('relatedCardNumber') or '')\n    vars['joint_text'] = ''\n    if rel in ('M', 'C'):\n        txt += ' Bu kart, sonu ' + digits(rnum[-4:]) + ' ile biten ' + rn + ' kartınızla ortak ekstreye sahiptir ve iki kartın hesap kesim tarihi aynıdır.'\n        if rel == 'M':\n            vars['joint_text'] = 'Bu değişiklik kartınıza bağlı ' + rn + ' kartınızı da etkileyecek. '\n        else:\n            vars['joint_text'] = 'Bu değişiklik kartınızın bağlı olduğu ' + rn + ' kartınızı da etkileyecek. '\n    others = [str(w) for w in (1, 2, 3, 4) if w != cw]\n    vars['week_options'] = 'Hesap kesim tarihinizi ayın ' + ', '.join(o + '.' for o in others[:-1]) + ' ya da ' + others[-1] + '. haftasına alabilirim. Hangisini tercih edersiniz?'\n    vars['week_intro'] = 'Hesap kesim tarihinizi yılda bir kez değiştirebilirsiniz. ' + txt\n    vars['week_choice'] = 'unclear'\n'''\nNODES[\"load_week\"] = api_node(\"load_week\", api(\"statement_week_get\", \"/statement.week.get\",\n    \"dict(cardNumber=str(vars.get('sel_card') or ''))\", WEEK_POST), [\n    T(\"ask_week\", cond(\"week_state\", \"equals\", \"ok\")),\n    T(\"end_week_error\", ALWAYS)])\n\nNODES[\"ask_week\"] = {\n    \"name\": \"ask_week\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"{{week_intro}} {{week_options}}\"},\n    \"task_message\": \"You told the caller their current statement week and offered the other weeks: \\\"{{week_options}}\\\". Do not call any tool. The current week is {{cur_week}}. The caller can only choose one of the offered weeks. If they name a day, a date or anything else, read the options again. If they choose week {{cur_week}}, say their statement is already in that week and nothing needs changing, then read the options again. Never say a new date yourself.\",\n    \"extraction_schema\": [{\"name\": \"week_choice\", \"type\": \"string\", \"min_confidence\": 0.5, \"enum_values\": [\"1\", \"2\", \"3\", \"4\", \"none\", \"unclear\"],\n                           \"description\": \"From the LAST message: the week of the month the caller chooses (1, 2, 3 or 4; 'üçüncü hafta' = 3). none = does not want to change; unclear = a day/date or anything else.\"}],\n    \"transitions\": [\n        T(\"end_menu\", cond(\"week_choice\", \"equals\", \"none\")),\n        T(\"check_week\", {\"logic\": \"or\", \"conditions\": [{\"variable\": \"week_choice\", \"operator\": \"equals\", \"operand\": w} for w in \"1234\"]})],\n    \"max_node_turns\": 4, \"max_turn_transition\": \"end_tries\",\n}\nNODES[\"check_week\"] = code_node(\"check_week\", r'''\nw = str(vars.get('week_choice') or '')\nvars['wk_ok'] = 'same' if w == str(vars.get('cur_week')) else 'ok'\nvars['new_week'] = w\nvars['week_choice'] = 'unclear'\n''', [T(\"ask_week\", cond(\"wk_ok\", \"equals\", \"same\")), T(\"decide_week\", ALWAYS)])\n\nDECIDE_POST = r'''\nok, sc, b = ok_of(result)\nif not ok:\n    vars['dec_state'] = 'error'\nelse:\n    d = b['data']\n    vars['dec_state'] = 'ok'\n    vars['new_stmt'] = sdate(d.get('statementDate'))\n    vars['new_due'] = sdate(d.get('statementDueDate'))\n    vars['confirm_text'] = str(vars.get('joint_text') or '') + 'Yeni hesap kesim haftanız her ayın ' + str(vars.get('new_week')) + '. haftası olacak. Yeni hesap kesim tarihiniz ' + vars['new_stmt'] + ', son ödeme tarihiniz ' + vars['new_due'] + ' olacak. Onaylıyor musunuz?'\n    vars['week_ok'] = ''\n'''\nWEEK_BODY = \"dict(cardNumber=str(vars.get('sel_card') or ''), newStatementWeek=int(vars.get('new_week') or 0), statementDay=int(vars.get('stmt_day') or 0))\"\nNODES[\"decide_week\"] = api_node(\"decide_week\", api(\"statement_week_decide\", \"/statement.week.decide\", WEEK_BODY, DECIDE_POST), [\n    T(\"confirm_week\", cond(\"dec_state\", \"equals\", \"ok\")),\n    T(\"end_week_error\", ALWAYS)])\nNODES[\"confirm_week\"] = {\n    \"name\": \"confirm_week\", \"node_type\": \"conversation\",\n    \"on_enter\": {\"type\": \"tts\", \"text\": \"{{confirm_text}}\"},\n    \"task_message\": \"You read the new statement dates and asked for confirmation: \\\"{{confirm_text}}\\\". Do not call any tool and never say the change was made. Only a clear 'evet' counts as yes. If the answer is hedged ('olur herhalde', 'galiba', 'sanırım') or unclear, ask plainly: \\\"Değişikliği onaylıyor musunuz? Lütfen evet ya da hayır deyin.\\\"\",\n    \"extraction_schema\": [{\"name\": \"week_ok\", \"type\": \"string\", \"min_confidence\": 0.5, \"enum_values\": [\"yes\", \"no\", \"unclear\"],\n                           \"description\": \"From the LAST message only: yes = a clear, unhedged yes (evet, evet onaylıyorum). no = no / vazgeçtim. unclear = hedged ('olur herhalde', 'galiba', 'sanırım', 'olabilir') or anything else.\"}],\n    \"transitions\": [T(\"change_week\", cond(\"week_ok\", \"equals\", \"yes\")), T(\"end_menu\", cond(\"week_ok\", \"equals\", \"no\"))],\n    \"max_node_turns\": 3, \"max_turn_transition\": \"end_tries\",\n}\nCHANGE_POST = r'''\nok, sc, b = ok_of(result)\nd = b.get('data') if ok else None\nvars['chg_state'] = 'ok' if (ok and str(d.get('exitState')) == 'OK' and str(d.get('responseCode')) in ('0', '0.0')) else 'error'\nname = str(vars.get('sel_name') or '').strip()\nvars['done_text'] = 'Sonu ' + digits(vars.get('sel_last4') or '') + ' ile biten ' + (name + ' ' if name else '') + 'kartınızın hesap kesim haftası her ayın ' + str(vars.get('new_week')) + '. haftası olarak değiştirildi. Yeni hesap kesim tarihiniz ' + str(vars.get('new_stmt')) + ', son ödeme tarihiniz ' + str(vars.get('new_due')) + '. Sizi ana menüye yönlendiriyorum.'\n'''\nNODES[\"change_week\"] = api_node(\"change_week\", api(\"statement_week_change\", \"/statement.week.change\", WEEK_BODY, CHANGE_POST, retries=0), [\n    T(\"end_changed\", cond(\"chg_state\", \"equals\", \"ok\")),\n    T(\"end_week_error\", ALWAYS)])\n\n# ---------------------------------------------------------------- ends\nNODES[\"end_menu\"] = end(\"end_menu\", \"main_menu\", MENU)\nNODES[\"end_nocard\"] = end(\"end_nocard\", \"no_eligible_card\", \"Ekstre borcunu sorgulayabileceğiniz uygun bir kredi kartınız bulunmuyor. Sizi ana menüye aktarıyorum.\")\nNODES[\"end_error\"] = end(\"end_error\", \"agent_service_error\", ERR)\nNODES[\"end_week_error\"] = end(\"end_week_error\", \"agent_week_service_error\", WEEK_ERR)\nNODES[\"end_tries\"] = end(\"end_tries\", \"main_menu_tries\", \"Size şu anda yardımcı olamıyorum. Sizi ana menüye aktarıyorum.\")\nNODES[\"end_sent\"] = end(\"end_sent\", \"statement_sent\", \"Ekstreniz kayıtlı e-posta adresinize gönderildi. \" + MENU)\nNODES[\"end_not_mine\"] = end(\"end_not_mine\", \"main_menu_email_declined\", \"Bu görüşmede e-posta adresinizi değiştiremiyorum, bu nedenle ekstreniz gönderilmedi. \" + MENU)\nNODES[\"end_changed\"] = end(\"end_changed\", \"statement_week_changed\", \"{{done_text}}\")\nNODES[\"end_agent\"] = end(\"end_agent\", \"agent_requested\", \"Sizi müşteri temsilcimize aktarıyorum.\")\nNODES[\"end_pay\"] = end(\"end_pay\", \"agent_payment\", \"Borç ödeme işleminiz için sizi müşteri temsilcimize aktarıyorum.\")\nNODES[\"end_dispute\"] = end(\"end_dispute\", \"agent_dispute\", \"Bu konuda size müşteri temsilcimiz yardımcı olacak, sizi aktarıyorum.\")\nNODES[\"end_angry\"] = end(\"end_angry\", \"agent_angry\", \"Sizi müşteri temsilcimize aktarıyorum.\")\nNODES[\"end_lang\"] = end(\"end_lang\", \"main_menu_language\", \"Sizi ana menüye aktarıyorum.\")\nNODES[\"end_silence\"] = end(\"end_silence\", \"silence_hangup\", \"Sesinizi alamadığım için görüşmeyi sonlandırıyorum.\")\nNODES[\"end_other_person\"] = end(\"end_other_person\", \"security_other_person\", \"Güvenlik nedeniyle yalnızca kendi kartlarınızla ilgili bilgi verebilir ve işlem yapabilirim. \" + MENU)\nNODES[\"end_oos\"] = end(\"end_oos\", \"main_menu_out_of_scope\", \"Sizi ana menüye aktarıyorum.\")\n\nENDS = [k for k, v in NODES.items() if v[\"node_type\"] == \"end_call\"]\nPASS = [k for k, v in NODES.items() if v.get(\"passthrough\")]\nEXCL = ENDS + PASS\n\n\ndef gnode(name, intent, target, extra_excl=()):\n    return {\"name\": name, \"node_type\": \"conversation\", \"description\": intent,\n            \"condition\": {\"operator\": \"matches_intent\", \"description\": intent},\n            \"on_enter\": {\"type\": \"silent\"}, \"passthrough\": True, \"passthrough_default_transition\": target,\n            \"excluded_nodes\": EXCL + list(extra_excl), \"task_message\": \"Do not speak.\",\n            \"transitions\": [T(target, ALWAYS)]}\n\n\nGLOBALS = {\n    \"g_agent\": gnode(\"g_agent\", \"The caller asks to speak to a human, a customer representative, an operator (müşteri temsilcisi, operatör, gerçek kişi).\", \"end_agent\"),\n    \"g_pay\": gnode(\"g_pay\", \"The caller wants to pay the debt now, or asks how or where to pay (ödeme yapmak istiyorum, nasıl öderim).\", \"end_pay\"),\n    \"g_dispute\": gnode(\"g_dispute\", \"The caller says the debt amount is wrong, or that a payment they made is not showing.\", \"end_dispute\"),\n    \"g_other\": gnode(\"g_other\", \"The caller asks about or wants a transaction on someone else's card (spouse, wife, husband, mother, father, child, friend: eşimin kartı, annemin kartı).\", \"end_other_person\"),\n    \"g_lang\": gnode(\"g_lang\", \"The caller's last message is written in a language other than Turkish (e.g. English, German, Arabic).\", \"end_lang\"),\n    \"g_oos\": {\n        \"name\": \"g_oos\", \"node_type\": \"conversation\",\n        \"description\": \"Question outside this step\",\n        \"condition\": {\"operator\": \"matches_intent\", \"description\": \"The caller asks something outside statement debt, statement e-mail and statement week change: interest or loan rates, available limit, points/miles, instalments, card blocking, address change, branch hours, next month's bill.\"},\n        \"on_enter\": {\"type\": \"tts\", \"text\": \"Size bu konuda yardımcı olamıyorum. Sizi ana menüye aktarmamı ister misiniz?\"},\n        \"task_message\": \"You asked whether to transfer the caller to the main menu. Do not call any tool. If the answer is unclear, ask again: \\\"Sizi ana menüye aktarmamı ister misiniz?\\\" If the caller wants to continue, say \\\"Peki, devam ediyorum.\\\" and repeat your previous question.\",\n        \"extraction_schema\": [{\"name\": \"oos_ans\", \"type\": \"string\", \"min_confidence\": 0.5, \"enum_values\": [\"yes\", \"no\", \"unclear\"],\n                               \"description\": \"From the LAST message: yes = wants the main menu; no = wants to continue here; unclear otherwise.\"}],\n        \"excluded_nodes\": EXCL + [\"g_oos\"],\n        \"transitions\": [T(\"end_oos\", cond(\"oos_ans\", \"equals\", \"yes\")), T(\"__previous__\", cond(\"oos_ans\", \"equals\", \"no\"))],\n        \"max_node_turns\": 3, \"max_turn_transition\": \"end_tries\",\n    },\n    \"g_angry\": {\n        \"name\": \"g_angry\", \"node_type\": \"code\", \"description\": \"Angry caller\",\n        \"condition\": {\"operator\": \"matches_intent\", \"description\": \"The caller is angry, shouting, complaining or swearing/insulting (not simply asking for a person).\"},\n        \"on_enter\": {\"type\": \"tts\", \"text\": \"Yaşadığınız durumu anlıyorum, size yardımcı olmak için buradayım.\"},\n        \"passthrough\": True, \"passthrough_default_transition\": \"__previous__\",\n        \"excluded_nodes\": EXCL + [\"g_angry\"],\n        \"pre_actions\": NODES[\"start\"][\"pre_actions\"][:0] + [{\"type\": \"function\", \"function\": {\"name\": \"code_exec\", \"handler\": \"__function__:code_exec\",\n            \"parameters\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\", \"default\": \"try:\\n    vars['anger_count'] = int(vars.get('anger_count') or 0) + 1\\nexcept Exception:\\n    vars['anger_count'] = 1\\n\"},\n                                                              \"timeout_ms\": {\"type\": \"number\", \"default\": 5000}}}}}],\n        \"transitions\": [T(\"end_angry\", cond(\"anger_count\", \"greater_than\", 3)), T(\"__previous__\", ALWAYS)],\n    },\n    \"g_silence\": {\n        \"name\": \"g_silence\", \"node_type\": \"code\", \"description\": \"Silence\",\n        \"condition\": {\"operator\": \"matches_intent\", \"description\": \"The caller's last message is empty or only silence markers ('...', '[sessizlik]', '[silence]').\"},\n        \"on_enter\": {\"type\": \"tts\", \"text\": \"Sizi duyamıyorum.\"},\n        \"passthrough\": True, \"passthrough_default_transition\": \"__previous__\",\n        \"excluded_nodes\": EXCL + [\"g_silence\"],\n        \"pre_actions\": [{\"type\": \"function\", \"function\": {\"name\": \"code_exec\", \"handler\": \"__function__:code_exec\",\n            \"parameters\": {\"type\": \"object\", \"properties\": {\"code\": {\"type\": \"string\", \"default\": \"try:\\n    vars['silence_count'] = int(vars.get('silence_count') or 0) + 1\\nexcept Exception:\\n    vars['silence_count'] = 1\\n\"},\n                                                              \"timeout_ms\": {\"type\": \"number\", \"de
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tTbC1XuGTqugne89A73Mz","type":"tool_result","content":"900\t    )\n901\t    return src\n902\t\n903\t\n904\tdef freya_tool(\n905\t    t: ToolDef,\n906\t    description: str,\n907\t    *,\n908\t    bake: dict[str, str] | None = None,\n909\t    model_names: dict[str, str] | None = None,\n910\t    field_notes: dict[str, str] | None = None,\n911\t    timeout_ms: int = 12000,\n912\t    max_retries: int = 0,\n913\t    pre_code: str = \"\",\n914\t    post_code: str = \"\",\n915\t    response_mapping: list[dict[str, str]] | None = None,\n916\t    extra_config: dict[str, Any] | None = None,\n917\t    model_filled: bool = True,\n918\t    consts: dict[str, Any] | None = None,\n919\t) -> dict[str, Any]:\n920\t    \"\"\"One `api_call` function. `bake` maps a field to a call variable that is always set\n921\t    (the workflow supplies it; the model never sees it). `consts` maps a field to a constant\n922\t    (the spec's value for a required field no role fills). Other fields are model-filled with\n923\t    `default: \"{{<model_name>}}\"` (docs: a default naming an unset variable is model-filled).\n924\t    `model_filled=False` (a call the engine runs: no model fills it): an optional field no\n925\t    role binds is left out, so a variable of the same name never fills it.\"\"\"\n926\t    bake = bake or {}\n927\t    consts = consts or {}\n928\t    model_names = model_names or {}\n929\t    field_notes = field_notes or {}\n930\t    props: dict[str, Any] = {}\n931\t    required: list[str] = []\n932\t    for f in t.fields:\n933\t        leaf: dict[str, Any] = {\n934\t            \"type\": f.type if f.type in (\"string\", \"number\", \"integer\", \"boolean\") else \"string\"\n935\t        }\n936\t        if not model_filled and f.name not in bake and f.name not in consts and not f.required:\n937\t            continue\n938\t        if f.name in bake:\n939\t            leaf[\"default\"] = \"{{\" + bake[f.name] + \"}}\"\n940\t        elif f.name in consts:\n941\t            leaf[\"default\"] = consts[f.name]\n942\t        elif f.required and fixed_value(f) is not None:\n943\t            # a required field no role fills (currency: GBP): the API's own value. An\n944\t            # api_request node has no model that could fill a \"{{name}}\" default.\n945\t            leaf[\"default\"] = fixed_value(f)\n946\t        else:\n947\t            leaf[\"default\"] = \"{{\" + model_names.get(f.name, f.name) + \"}}\"\n948\t            desc = \" \".join(x for x in (f.description, field_notes.get(f.name, \"\")) if x)\n949\t            if f.enum:\n950\t                desc = (desc + \" \" if desc else \"\") + \"One of: \" + \", \".join(f.enum) + \".\"\n951\t                leaf[\"enum\"] = list(f.enum)\n952\t            if desc:\n953\t                leaf[\"description\"] = desc\n954\t            if f.required:\n955\t                required.append(f.name)\n956\t        props[f.name] = leaf\n957\t    out: dict[str, Any] = {\n958\t        \"type\": \"function\",\n959\t        \"config\": {\"timeoutMs\": timeout_ms, \"maxRetries\": max_retries, **(extra_config or {})},\n960\t        \"function\": {\n961\t            \"name\": t.name,\n962\t            \"handler\": \"__function__:api_call\",\n963\t            \"description\": description,\n964\t            \"parameters\": {\n965\t                \"type\": \"object\",\n966\t                \"properties\": {\n967\t                    \"url\": {\"type\": \"string\", \"default\": t.url},\n968\t                    \"method\": {\"type\": \"string\", \"default\": t.method},\n969\t                    \"headers\": {\n970\t                        \"type\": \"object\",\n971\t                        \"properties\": {\n972\t                            \"Content-Type\": {\"type\": \"string\", \"default\": \"application/json\"},\n973\t                            **{\n974\t                                k: {\"type\": \"string\", \"default\": v}\n975\t                                for k, v in t.headers.items()\n976\t                                if k.lower() != \"content-type\"\n977\t                            },\n978\t                        },\n979\t                    },\n980\t                    \"body\": {\"type\": \"object\", \"properties\": props, \"required\": required},\n981\t                },\n982\t            },\n983\t        },\n984\t    }\n985\t    if pre_code:\n986\t        out[\"pre_process_code\"] = pre_code\n987\t    if post_code:\n988\t        out[\"post_process_code\"] = post_code\n989\t    if response_mapping:\n990\t        out[\"response_mapping\"] = copy.deepcopy(response_mapping)\n991\t    return out\n992\t"}]},"parent_tool_use_id":null,"session_id":"abc9990b-2e37-4da6-87b0-3f0fa959dc15","uuid":"114cd1b2-ed37-4fdc-b19d-fe40722bebe0","timestamp":"2026-10-11T17:57:32.615Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Burak\\Desktop\\Projects\\agent-builder\\.claude\\worktrees\\final-case\\builder\\fb\\openapi_tools.py","content":"    )\n    return src\n\n\ndef freya_tool(\n    t: ToolDef,\n    description: str,\n    *,\n    bake: dict[str, str] | None = None,\n    model_names: dict[str, str] | None = None,\n    field_notes: dict[str, str] | None = None,\n    timeout_ms: int = 12000,\n    max_retries: int = 0,\n    pre_code: str = \"\",\n    post_code: str = \"\",\n    response_mapping: list[dict[str, str]] | None = None,\n    extra_config: dict[str, Any] | None = None,\n    model_filled: bool = True,\n    consts: dict[str, Any] | None = None,\n) -> dict[str, Any]:\n    \"\"\"One `api_call` function. `bake` maps a field to a call variable that is always set\n    (the workflow supplies it; the model never sees it). `consts` maps a field to a constant\n    (the spec's value for a required field no role fills). Other fields are model-filled with\n    `default: \"{{<model_name>}}\"` (docs: a default naming an unset variable is model-filled).\n    `model_filled=False` (a call the engine runs: no model fills it): an optional field no\n    role binds is left out, so a variable of the same name never fills it.\"\"\"\n    bake = bake or {}\n    consts = consts or {}\n    model_names = model_names or {}\n    field_notes = field_notes or {}\n    props: dict[str, Any] = {}\n    required: list[str] = []\n    for f in t.fields:\n        leaf: dict[str, Any] = {\n            \"type\": f.type if f.type in (\"string\", \"number\", \"integer\", \"boolean\") else \"string\"\n        }\n        if not model_filled and f.name not in bake and f.name not in consts and not f.required:\n            continue\n        if f.name in bake:\n            leaf[\"default\"] = \"{{\" + bake[f.name] + \"}}\"\n        elif f.name in consts:\n            leaf[\"default\"] = consts[f.name]\n        elif f.required and fixed_value(f) is not None:\n            # a required field no role fills (currency: GBP): the API's own value. An\n            # api_request node has no model that could fill a \"{{name}}\" default.\n            leaf[\"default\"] = fixed_value(f)\n        else:\n            leaf[\"default\"] = \"{{\" + model_names.get(f.name, f.name) + \"}}\"\n            desc = \" \".join(x for x in (f.description, field_notes.get(f.name, \"\")) if x)\n            if f.enum:\n                desc = (desc + \" \" if desc else \"\") + \"One of: \" + \", \".join(f.enum) + \".\"\n                leaf[\"enum\"] = list(f.enum)\n            if desc:\n                leaf[\"description\"] = desc\n            if f.required:\n                required.append(f.name)\n        props[f.name] = leaf\n    out: dict[str, Any] = {\n        \"type\": \"function\",\n        \"config\": {\"timeoutMs\": timeout_ms, \"maxRetries\": max_retries, **(extra_config or {})},\n        \"function\": {\n            \"name\": t.name,\n            \"handler\": \"__function__:api_call\",\n            \"description\": description,\n            \"parameters\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"url\": {\"type\": \"string\", \"default\": t.url},\n                    \"method\": {\"type\": \"string\", \"default\": t.method},\n                    \"headers\": {\n                        \"type\": \"object\",\n                        \"properties\": {\n                            \"Content-Type\": {\"type\": \"string\", \"default\": \"application/json\"},\n                            **{\n                                k: {\"type\": \"string\", \"default\": v}\n                                for k, v in t.headers.items()\n                                if k.lower() != \"content-type\"\n                            },\n                        },\n                    },\n                    \"body\": {\"type\": \"object\", \"properties\": props, \"required\": required},\n                },\n            },\n        },\n    }\n    if pre_code:\n        out[\"pre_process_code\"] = pre_code\n    if post_code:\n        out[\"post_process_code\"] = post_code\n    if response_mapping:\n        out[\"response_mapping\"] = copy.deepcopy(response_mapping)\n    return out\n","numLines":93,"startLine":900,"totalLines":992}}}

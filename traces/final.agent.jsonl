"__name__\": \"gen\"})\n    elif cmd == \"dryrun\":\n        try:\n            freya.validate_workflow(SLOT + \" dry run\", load())\n            print(\"DRY RUN OK\")\n        except RuntimeError as e:\n            print(\"DRY RUN FAILED:\", str(e)[:3000])\n            return 1\n    elif cmd == \"save\":\n        s = freya.save_workflow(SLOT, load(), state_file=STATE)\n        print(\"SAVED\", json.dumps(s))\n    elif cmd == \"chat\":\n        state = json.load(open(STATE, encoding=\"utf-8\"))\n        wf_id = state[SLOT][\"workflow_id\"]\n        cv = json.loads(argv[2])\n        call_id = None\n        for msg in argv[3:]:\n            body = {\"workflowId\": wf_id, \"message\": msg, \"customerVariables\": cv}\n            if call_id:\n                body[\"callId\"] = call_id\n            t = time.time()\n            try:\n                r = freya.api(\"POST\", \"/api/v2/chat/message\", body)\n            except RuntimeError as e:\n                print(f\"USER: {msg}\\n  !! chat error after {time.time()-t:.0f}s: {str(e)[:400]}\")\n                continue\n            call_id = r.get(\"callId\") or call_id\n            print(f\"USER: {msg}\\nAGENT: {r.get('response')}\" + (f\"  [error: {r.get('error')}]\" if r.get(\"error\") else \"\"))\n            if r.get(\"ended\") or r.get(\"callEnded\"):\n                print(\"  (call ended)\")\n        if call_id:\n            try:\n                freya.api(\"POST\", \"/api/v2/chat/end\", {\"callId\": call_id})\n            except RuntimeError:\n                pass\n            try:\n                c = freya.get_call(call_id)\n                import os\n                if os.path.exists(\"dbg.flag\"):\n                    for m in c.get(\"messages\") or []:\n                        print(\"  MSG:\", json.dumps(m, ensure_ascii=False)[:1500])\n                    for k, v in c.items():\n                        if \"var\" in k.lower() or \"state\" in k.lower():\n                            print(\"  \", k, json.dumps(v, ensure_ascii=False)[:4000])\n                for m in c.get(\"messages\") or []:\n                    if m.get(\"role\") in (\"tool\", \"function\") or m.get(\"tool_calls\") or m.get(\"toolCalls\"):\n                        print(\"  TOOL:\", json.dumps(m, ensure_ascii=False)[:600])\n            except Exception as e:\n                print(\"  (call events unavailable:\", str(e)[:200], \")\")\n    else:\n        print(__doc__)\n        return 2\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))\n","structuredPatch":[{"oldStart":59,"oldLines":7,"newStart":59,"newLines":9,"lines":["                 import os","                 if os.path.exists(\"dbg.flag\"):","                     for m in c.get(\"messages\") or []:","-                        print(\"  MSG:\", json.dumps(m, ensure_ascii=False)[:1500])","+                        mm = str(m.get(\"message\") or \"\")","+                        if m.get(\"role\") == \"system\" and (\"node_enter\" in mm or \"function_call_complete\" in mm or \"validation\" in mm or \"error\" in mm.lower()[:200]):","+                            print(\"  SYS:\", mm[:350])","                     for k, v in c.items():","                         if \"var\" in k.lower() or \"state\" in k.lower():","                             print(\"  \", k, json.dumps(v, ensure_ascii=False)[:4000])"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}
